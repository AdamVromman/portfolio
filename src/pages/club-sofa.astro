---
import ProjectPage from "../components/ProjectPage.astro";
import Layout from "../layouts/Layout.astro";
import "../CSS/club-sofa.css";
import SingleFlyingObject from "../components/SingleFlyingObject.astro";
import { projects } from "../assets/Constants";

const project = projects[0];
---

<Layout slug="club-sofa">
  <ProjectPage slug="club-sofa">
    <div class="grid_cell project-page_grid_title">
      <div class="grid_cell_container">
        <h1 class="full-col-text page-title">Club sofa</h1>
      </div>
    </div>
    <div class="grid_cell project-page_grid_category ux first">
      <div class="grid_cell_container">
        <span class="half-col-text">UX</span>
      </div>
    </div>
    <div class="grid_cell project-page_grid_category design second">
      <div class="grid_cell_container">
        <span class="half-col-text">Design</span>
      </div>
    </div>
    <div class="grid_cell project-page_grid_year">
      <div class="grid_cell_container">
        <span class="half-col-text">{project.year}</span>
      </div>
    </div>
    <div class="grid_cell project-page_grid_description">
      <div class="grid_cell_container">
        <p class="half-col-text justified-paragraph">
          A cocktail-ingredient monthly-subscription service and application,
          made for young creatives; I used this school project to experiment
          with illustration, branding and creative onboarding.
        </p>
      </div>
    </div>
    <div class="grid_cell project-page_grid_icon">
      <div class="grid_cell_container">
        <SingleFlyingObject slug="club-sofa" />
      </div>
    </div>
    <div class="project-page-image image-1">
      <img src="/assets/club-sofa/logo-still.webp" />
    </div>
    <div class="project-page-video video-1">
      <video
        src="/assets/club-sofa/ANIMATION-logotype.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-video video-2 full-width">
      <video
        src="/assets/club-sofa/ANIMATION-icons.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="grid_cell project-page_grid_paragraph paragraph-1">
      <div class="grid_cell_container">
        <p class="third-col-text justified-paragraph">
          For me, the main challenge lay in finding a balance between my own
          vision and ideas for the brand and what the intended audience would
          be. I had to go for something that encompasses both the fun, summer-y,
          party music aspect of cocktails and the luxurious, premium
          ingredients, fancy one.
        </p>
      </div>
    </div>
    <div class="project-page-image image-2 border">
      <img src="/assets/club-sofa/phone.webp" />
    </div>
    <div class="project-page-video video-3">
      <video
        src="/assets/club-sofa/ANIMATION-screens-desktop.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-image image-3 border">
      <img src="/assets/club-sofa/phone-2.webp" />
    </div>
    <div class="grid_cell project-page_grid_paragraph paragraph-2">
      <div class="grid_cell_container">
        <p class="third-col-text justified-paragraph">
          As a delivery service, another important aspect was the packaging. I
          had a lot of fun coming up with different designs for the differently
          themed boxes and seeing my vision come to life when I created mock-ups
          with my designs. I think the combination of physical design with
          application design made the assignment so engaging.
        </p>
      </div>
    </div>
    <div class="project-page-video video-4">
      <video
        src="/assets/club-sofa/ANIMATION-boxes.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-image image-4 border">
      <img src="/assets/club-sofa/boxes.webp" />
    </div>
    <div class="project-page-image image-5 full-width">
      <img src="/assets/club-sofa/box-1.webp" />
    </div>
    <div class="project-page-image image-6 border">
      <img src="/assets/club-sofa/ipad.webp" />
    </div>
  </ProjectPage>
</Layout>
