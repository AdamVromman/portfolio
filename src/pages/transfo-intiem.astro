---
import ProjectPage from "../components/ProjectPage.astro";
import Layout from "../layouts/Layout.astro";
import "../CSS/transfo-intiem.css";
---

<Layout slug="transfo-intiem">
  <ProjectPage slug="transfo-intiem">
    <div class="grid_cell project-page_grid_title">
      <div class="grid_cell_container">
        <h1 class="full-col-text page-title">Transfo Intiem</h1>
      </div>
    </div>
    <div class="grid_cell project-page_grid_category dev first">
      <div class="grid_cell_container">
        <span class="half-col-text">Dev</span>
      </div>
    </div>
    <div class="grid_cell project-page_grid_category ux second">
      <div class="grid_cell_container">
        <span class="half-col-text">UX</span>
      </div>
    </div>
    <div class="grid_cell project-page_grid_description">
      <div class="grid_cell_container">
        <p class="half-col-text justified-paragraph">
          During my second year, I created this website to recount—through
          illustration, interaction and animation—a forgotten tale. I just
          called it a love letter to the Belgian postal trains.
        </p>
      </div>
    </div>
    <div class="grid_cell project-page_grid_icon">
      <div class="grid_cell_container"></div>
    </div>
    <div class="project-page-video video-1 border">
      <video
        src="/assets/transfo-intiem/ANIMATION-mockup-both.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="grid_cell project-page_grid_paragraph paragraph-1">
      <div class="grid_cell_container">
        <p class="third-col-text justified-paragraph">
          For me, the main challenge lay in finding a balance between my own
          vision and ideas for the brand and what the intended audience would
          be. I had to go for something that encompasses both the fun, summer-y,
          party music aspect of cocktails and the luxurious, premium
          ingredients, rich-people one.
        </p>
      </div>
    </div>
    <div class="project-page-video video-2">
      <video
        src="/assets/transfo-intiem/ANIMATION-screen-faq.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-video video-3">
      <video
        src="/assets/transfo-intiem/ANIMATION-screen-button.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-video video-4">
      <video
        src="/assets/transfo-intiem/ANIMATION-screen-planning.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="grid_cell project-page_grid_paragraph paragraph-2">
      <div class="grid_cell_container">
        <p class="third-col-text justified-paragraph">
          For me, the main challenge lay in finding a balance between my own
          vision and ideas for the brand and what the intended audience would
          be. I had to go for something that encompasses both the fun, summer-y,
          party music aspect of cocktails and the luxurious, premium
          ingredients, rich-people one.
        </p>
      </div>
    </div>
    <div class="project-page-image image-1">
      <img src="/assets/transfo-intiem/flyers.webp" />
    </div>
    <div class="project-page-video video-5">
      <video
        src="/assets/transfo-intiem/ANIMATION-3d-model.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-image image-2">
      <img src="/assets/transfo-intiem/bus-stop.webp" />
    </div>
    <div class="project-page-video video-6">
      <video
        src="/assets/transfo-intiem/ANIMATION-mockup-laptop.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-video video-7">
      <video
        src="/assets/transfo-intiem/ANIMATION-mockup-phone.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
  </ProjectPage>
</Layout>
