---
import ProjectPage from "../components/ProjectPage.astro";
import Layout from "../layouts/Layout.astro";
import "../CSS/all-eyes-on-gaza.css";
---

<Layout slug="all-eyes-on-gaza">
  <ProjectPage slug="all-eyes-on-gaza">
    <div class="grid_cell project-page_grid_title">
      <div class="grid_cell_container">
        <h1 class="full-col-text page-title">All Eyes On Gaza</h1>
      </div>
    </div>
    <div class="grid_cell project-page_grid_category dev first">
      <div class="grid_cell_container">
        <span class="half-col-text">Dev</span>
      </div>
    </div>
    <div class="grid_cell project-page_grid_category ux second">
      <div class="grid_cell_container">
        <span class="half-col-text">UX</span>
      </div>
    </div>
    <div class="grid_cell project-page_grid_description">
      <div class="grid_cell_container">
        <p class="half-col-text justified-paragraph">
          During my second year, I created this website to recount—through
          illustration, interaction and animation—a forgotten tale. I just
          called it a love letter to the Belgian postal trains.
        </p>
      </div>
    </div>
    <div class="grid_cell project-page_grid_icon">
      <div class="grid_cell_container"></div>
    </div>
    <div class="project-page-video video-1 bg-[#171717]">
      <video
        src="/assets/all-eyes-on-gaza/ANIMATION-intro.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-video video-2 bg-[#171717]">
      <video
        src="/assets/all-eyes-on-gaza/ANIMATION-scroll.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-video video-3 bg-[#171717]">
      <video
        src="/assets/all-eyes-on-gaza/ANIMATION-adding.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-image image-1">
      <img src="/assets/all-eyes-on-gaza/still-data.webp" />
    </div>
    <div class="grid_cell project-page_grid_paragraph paragraph-1">
      <div class="grid_cell_container">
        <p class="third-col-text justified-paragraph">
          For me, the main challenge lay in finding a balance between my own
          vision and ideas for the brand and what the intended audience would
          be. I had to go for something that encompasses both the fun, summer-y,
          party music aspect of cocktails and the luxurious, premium
          ingredients, rich-people one.
        </p>
      </div>
    </div>
    <div class="project-page-video video-4 bg-[#171717]">
      <video
        src="/assets/all-eyes-on-gaza/ANIMATION-floating-info.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-video video-5 bg-[#171717]">
      <video
        src="/assets/all-eyes-on-gaza/ANIMATION-floating-info-different.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-image image-2">
      <img src="/assets/all-eyes-on-gaza/still-eye.webp" />
    </div>
    <div class="grid_cell project-page_grid_paragraph paragraph-2">
      <div class="grid_cell_container">
        <p class="third-col-text justified-paragraph">
          For me, the main challenge lay in finding a balance between my own
          vision and ideas for the brand and what the intended audience would
          be. I had to go for something that encompasses both the fun, summer-y,
          party music aspect of cocktails and the luxurious, premium
          ingredients, rich-people one.
        </p>
      </div>
    </div>
    <div class="project-page-video video-6">
      <video
        src="/assets/all-eyes-on-gaza/ANIMATION-dragging.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-video video-7 border">
      <video
        src="/assets/all-eyes-on-gaza/ANIMATION-zoom.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
  </ProjectPage>
</Layout>
