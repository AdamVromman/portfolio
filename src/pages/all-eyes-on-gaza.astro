---
import ProjectPage from "../components/ProjectPage.astro";
import Layout from "../layouts/Layout.astro";
import "../CSS/all-eyes-on-gaza.css";
import SingleFlyingObject from "../components/SingleFlyingObject.astro";
---

<Layout slug="all-eyes-on-gaza">
  <ProjectPage slug="all-eyes-on-gaza">
    <div class="grid_cell project-page_grid_title">
      <div class="grid_cell_container">
        <h1 class="full-col-text page-title">All Eyes On Gaza</h1>
      </div>
    </div>
    <div class="grid_cell project-page_grid_category dev first">
      <div class="grid_cell_container">
        <span class="half-col-text">Dev</span>
      </div>
    </div>
    <div class="grid_cell project-page_grid_category ux second">
      <div class="grid_cell_container">
        <span class="half-col-text">UX</span>
      </div>
    </div>
    <div class="grid_cell project-page_grid_year">
      <div class="grid_cell_container">
        <span class="half-col-text">2025</span>
      </div>
    </div>
    <div class="grid_cell project-page_grid_description">
      <div class="grid_cell_container">
        <p class="half-col-text justified-paragraph">
          This project is an exploration of interactive data visualisation, as
          well as attempt to highlight how data is misused to oppress the
          Palestinian people.
        </p>
      </div>
    </div>
    <div class="grid_cell project-page_grid_icon">
      <div class="grid_cell_container">
        <SingleFlyingObject slug="all-eyes-on-gaza" />
      </div>
    </div>
    <div class="project-page-video video-1 bg-[#171717] border">
      <video
        src="/assets/all-eyes-on-gaza/ANIMATION-intro.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-video video-2 bg-[#171717]">
      <video
        src="/assets/all-eyes-on-gaza/ANIMATION-scroll.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-video video-3 bg-[#171717]">
      <video
        src="/assets/all-eyes-on-gaza/ANIMATION-adding.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-image image-1">
      <img src="/assets/all-eyes-on-gaza/still-data.webp" />
    </div>
    <div class="grid_cell project-page_grid_paragraph paragraph-1">
      <div class="grid_cell_container">
        <p class="third-col-text justified-paragraph">
          For this school assignment, I explored the use of animation frameworks
          like GSAP to animate and visualise data. It consists of two parts. The
          eye, which is more abstract and less interactive, and the dashboard,
          which is more straight-forward data that the users can control
          themselves.
        </p>
      </div>
    </div>
    <div class="project-page-video video-4 bg-[#171717] border">
      <video
        src="/assets/all-eyes-on-gaza/ANIMATION-floating-info.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-video video-5 bg-[#171717] border">
      <video
        src="/assets/all-eyes-on-gaza/ANIMATION-floating-info-different.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-image image-2 full-width">
      <img src="/assets/all-eyes-on-gaza/still-eye.webp" />
    </div>
    <div class="grid_cell project-page_grid_paragraph paragraph-2">
      <div class="grid_cell_container">
        <p class="third-col-text justified-paragraph">
          The dashboard shows a timeline which contains, on the one hand, key
          moments and on the other hand, data that the user can add. Like that,
          a user can not only learn new things about Israel-Palestine, as well
          as see how historical moments influenced certain statistics.
        </p>
      </div>
    </div>
    <div class="project-page-video video-6">
      <video
        src="/assets/all-eyes-on-gaza/ANIMATION-dragging.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-video video-7 border">
      <video
        src="/assets/all-eyes-on-gaza/ANIMATION-zoom.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page_link link-1">
      <a href="https://passion-project-chi.vercel.app/" target="_blank">
        <span class="half-col-text">Visit the website</span>
      </a>
    </div>
  </ProjectPage>
</Layout>
