---
import ProjectPage from "../../components/ProjectPage.astro";
import Layout from "../../layouts/Layout.astro";
import "../../CSS/qausal.css";
import SingleFlyingObject from "../../components/SingleFlyingObject.astro";
import { getLanguage } from "../../assets/ServerFunctions";
import Languages from "../../assets/Languages.json";

const activeLanguage = getLanguage(Astro.currentLocale);
const copy = Languages[activeLanguage];
---

<Layout slug="qausal">
  <ProjectPage slug="qausal">
    <div class="grid_cell project-page_grid_title">
      <div class="grid_cell_container">
        <h1 class="full-col-text page-title">{copy.projects.qausal.title}</h1>
      </div>
    </div>
    <div class="grid_cell project-page_grid_category dev first">
      <div class="grid_cell_container">
        <span class="half-col-text">{copy.projects.types.development}</span>
      </div>
    </div>
    <div class="grid_cell project-page_grid_category ux second">
      <div class="grid_cell_container">
        <span class="half-col-text">{copy.projects.types.ux}</span>
      </div>
    </div>
    <div class="grid_cell project-page_grid_year">
      <div class="grid_cell_container">
        <span class="half-col-text">2025</span>
      </div>
    </div>
    <div class="grid_cell project-page_grid_description">
      <div class="grid_cell_container">
        <p class="half-col-text justified-paragraph">
          {copy.projects.qausal.description}
        </p>
      </div>
    </div>
    <div class="grid_cell project-page_grid_icon">
      <div class="grid_cell_container">
        <SingleFlyingObject slug="qausal" />
      </div>
    </div>
    <div class="project-page-image image-1">
      <img
        src="/assets/qausal/logo-still.webp"
        alt={copy.projects.qausal.alts.image1}
      />
    </div>
    <div class="project-page-video video-1 border">
      <video
        aria-label={copy.projects.qausal.alts.video1}
        src="/assets/qausal/ANIMATION-logo.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-video video-2">
      <video
        aria-label={copy.projects.qausal.alts.video2}
        src="/assets/qausal/ANIMATION-elements-3.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="grid_cell project-page_grid_paragraph paragraph-1">
      <div class="grid_cell_container">
        <p class="third-col-text justified-paragraph">
          {copy.projects.qausal.paragraph1}
        </p>
      </div>
    </div>
    <div class="project-page-image image-2 border">
      <img
        src="/assets/qausal/laptop.webp"
        alt={copy.projects.qausal.alts.image2}
      />
    </div>
    <div class="project-page-image image-3">
      <img
        src="/assets/qausal/double-screens.webp"
        alt={copy.projects.qausal.alts.image3}
      />
    </div>
    <div class="project-page-video video-3 full-width">
      <video
        aria-label={copy.projects.qausal.alts.video3}
        src="/assets/qausal/ANIMATION-elements-1.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-image image-4">
      <img
        src="/assets/qausal/book.webp"
        alt={copy.projects.qausal.alts.image4}
      />
    </div>
    <div class="grid_cell project-page_grid_paragraph paragraph-2">
      <div class="grid_cell_container">
        <p class="third-col-text justified-paragraph">
          {copy.projects.qausal.paragraph2}
        </p>
      </div>
    </div>
    <div class="project-page-video video-4 border">
      <video
        aria-label={copy.projects.qausal.alts.video4}
        src="/assets/qausal/ANIMATION-elements-2.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-image image-5">
      <img
        src="/assets/qausal/big-screen.webp"
        alt={copy.projects.qausal.alts.image5}
      />
    </div>
  </ProjectPage>
</Layout>
