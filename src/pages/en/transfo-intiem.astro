---
import ProjectPage from "../../components/ProjectPage.astro";
import Layout from "../../layouts/Layout.astro";
import "../../CSS/transfo-intiem.css";
import SingleFlyingObject from "../../components/SingleFlyingObject.astro";
import { getLanguage } from "../../assets/ServerFunctions";
import Languages from "../../assets/Languages.json";

const activeLanguage = getLanguage(Astro.currentLocale);
const copy = Languages[activeLanguage];
---

<Layout slug="transfo-intiem">
  <ProjectPage slug="transfo-intiem">
    <div class="grid_cell project-page_grid_title">
      <div class="grid_cell_container">
        <h1 class="full-col-text page-title">
          {copy.projects.transfoIntiem.title}
        </h1>
      </div>
    </div>
    <div class="grid_cell project-page_grid_category dev first">
      <div class="grid_cell_container">
        <span class="half-col-text">{copy.projects.types.development}</span>
      </div>
    </div>
    <div class="grid_cell project-page_grid_category ux second">
      <div class="grid_cell_container">
        <span class="half-col-text">{copy.projects.types.ux}</span>
      </div>
    </div>
    <div class="grid_cell project-page_grid_year">
      <div class="grid_cell_container">
        <span class="half-col-text">2024</span>
      </div>
    </div>
    <div class="grid_cell project-page_grid_description">
      <div class="grid_cell_container">
        <p class="half-col-text justified-paragraph">
          {copy.projects.transfoIntiem.description}
        </p>
      </div>
    </div>
    <div class="grid_cell project-page_grid_icon">
      <div class="grid_cell_container">
        <SingleFlyingObject slug="transfo-intiem" />
      </div>
    </div>
    <div class="project-page-video video-1 border">
      <video
        aria-label={copy.projects.transfoIntiem.alts.video1}
        src="/assets/transfo-intiem/ANIMATION-mockup-both.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="grid_cell project-page_grid_paragraph paragraph-1">
      <div class="grid_cell_container">
        <p class="third-col-text justified-paragraph">
          {copy.projects.transfoIntiem.paragraph1}
        </p>
      </div>
    </div>
    <div class="project-page-video video-2">
      <video
        aria-label={copy.projects.transfoIntiem.alts.video2}
        src="/assets/transfo-intiem/ANIMATION-screen-faq.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-video video-3">
      <video
        aria-label={copy.projects.transfoIntiem.alts.video3}
        src="/assets/transfo-intiem/ANIMATION-screen-button.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-video video-4 border">
      <video
        aria-label={copy.projects.transfoIntiem.alts.video4}
        src="/assets/transfo-intiem/ANIMATION-screen-planning.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="grid_cell project-page_grid_paragraph paragraph-2">
      <div class="grid_cell_container">
        <p class="third-col-text justified-paragraph">
          {copy.projects.transfoIntiem.paragraph2}
        </p>
      </div>
    </div>
    <div class="project-page-image image-1">
      <img
        src="/assets/transfo-intiem/flyers.webp"
        alt={copy.projects.transfoIntiem.alts.image1}
      />
    </div>
    <div class="project-page-video video-5 border">
      <video
        aria-label={copy.projects.transfoIntiem.alts.video5}
        src="/assets/transfo-intiem/ANIMATION-3d-model.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-image image-2 border">
      <img
        src="/assets/transfo-intiem/bus-stop.webp"
        alt={copy.projects.transfoIntiem.alts.image2}
      />
    </div>
    <div class="project-page-video video-6">
      <video
        aria-label={copy.projects.transfoIntiem.alts.video6}
        src="/assets/transfo-intiem/ANIMATION-mockup-laptop.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-video video-7 border">
      <video
        aria-label={copy.projects.transfoIntiem.alts.video7}
        src="/assets/transfo-intiem/ANIMATION-mockup-phone.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page_link link-1">
      <a href="https://transfo-web.vercel.app/" target="_blank">
        <span class="half-col-text">{copy.projects.visitTheWebsite}</span>
      </a>
    </div>
  </ProjectPage>
</Layout>
