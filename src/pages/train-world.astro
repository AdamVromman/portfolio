---
import ProjectPage from "../components/ProjectPage.astro";
import Layout from "../layouts/Layout.astro";
import "../CSS/train-world.css";
---

<Layout slug="train-world">
  <ProjectPage slug="train-world">
    <div class="grid_cell project-page_grid_title">
      <div class="grid_cell_container">
        <h1 class="full-col-text page-title">Train world</h1>
      </div>
    </div>
    <div class="grid_cell project-page_grid_category design first">
      <div class="grid_cell_container">
        <span class="half-col-text">Design</span>
      </div>
    </div>
    <div class="grid_cell project-page_grid_category dev second">
      <div class="grid_cell_container">
        <span class="half-col-text">Dev</span>
      </div>
    </div>
    <div class="grid_cell project-page_grid_description">
      <div class="grid_cell_container">
        <p class="half-col-text justified-paragraph">
          During my second year, I created this website to recount—through
          illustration, interaction and animation—the forgotten tale of the
          Belgian postal train service.
        </p>
      </div>
    </div>
    <div class="grid_cell project-page_grid_icon">
      <div class="grid_cell_container"></div>
    </div>
    <div class="project-page-video video-1 border">
      <video
        src="/assets/train-world/ANIMATION-train-cart-double.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-image image-1">
      <img src="/assets/train-world/train-cart-single.webp" />
    </div>
    <div class="project-page-video video-2">
      <video
        src="/assets/train-world/ANIMATION-loading.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="grid_cell project-page_grid_paragraph paragraph-1">
      <div class="grid_cell_container">
        <p class="third-col-text justified-paragraph">
          I had a lot of fun looking for an illustration style that highlights
          the complex engineering of trains and also works in the setting of the
          early 20th century. The colour is based on the iconic Belgian Post red
          and for the fonts, I looked for typewriter-inspired typographies.
        </p>
      </div>
    </div>
    <div class="project-page-image image-2">
      <img src="/assets/train-world/iphone.webp" />
    </div>
    <div class="project-page-image image-3 border">
      <img src="/assets/train-world/macBook.webp" />
    </div>
    <div class="project-page-video video-3 border">
      <video
        src="/assets/train-world/ANIMATION-clouds.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-image image-4">
      <img src="/assets/train-world/train-cart-open.webp" />
    </div>
    <div class="project-page-video video-4 border">
      <video
        src="/assets/train-world/ANIMATION-trees.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="grid_cell project-page_grid_paragraph paragraph-2">
      <div class="grid_cell_container">
        <p class="third-col-text justified-paragraph">
          For the different smaller illustrations throughout the website, I
          experimented with using parallel lines to shade the objects. Next to
          that, I also tried to recreate the visual language of plaques, signs
          and architectural decorations of the 20th century, which I used as UI
          elements.
        </p>
      </div>
    </div>
    <div class="project-page-video video-5">
      <video
        src="/assets/train-world/ANIMATION-illustrations.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page-video video-6">
      <video
        src="/assets/train-world/ANIMATION-labels.mp4"
        autoplay
        loop
        muted
        playsinline></video>
    </div>
    <div class="project-page_link link-1">
      <a href="/train-world/live" target="_blank">
        <span class="half-col-text">Visit the website</span>
      </a>
    </div>
  </ProjectPage>
</Layout>
