---
import "../CSS/background.css";
---

<div class="background_project-page">
  <svg class="background_project-page_svg"
    ><linearGradient id="background-gradient" x1="0%" x2="0%" y1="0%" y2="100%">
      <stop offset="0%" stop-color="#eeeeee" stop-opacity="0"></stop>
      <stop offset="100%" stop-color="#eeeeee" stop-opacity="1"></stop>
    </linearGradient>

    <g class="background_project-page_lines-group"></g>
  </svg>
</div>
