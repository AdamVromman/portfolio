---
import "../CSS/project-page.css";
import ProjectPageBackground from "./ProjectPageBackground.astro";
---

<div id="project-page">
  <ProjectPageBackground />
  <div id="project-page-grid">
    <slot />
  </div>
</div>
<script>
  import {
    calculateTileWidth,
    calculateNrOfRows,
    getNrOfColumns,
  } from "../assets/Functions";

  const projectPage = document.getElementById("project-page");
  const projectPageGrid = document.getElementById("project-page-grid");

  const drawGrid = () => {
    if (projectPageGrid) {
      const localTileWidth = calculateTileWidth();
      projectPageGrid.style.width = `${getNrOfColumns() * localTileWidth}px`;
      projectPageGrid.style.gridTemplateColumns = `repeat(${getNrOfColumns()}, ${localTileWidth}px)`;
      projectPageGrid.style.gridTemplateRows = `repeat(100, ${localTileWidth}px)`;
    }
  };

  drawGrid();
</script>
