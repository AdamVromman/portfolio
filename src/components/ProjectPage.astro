---
import "../CSS/project-page.css";
import Footer from "./Footer.astro";
import ProjectPageBackground from "./ProjectPageBackground.astro";

const { slug } = Astro.props;
---

<div id="project-page">
  <ProjectPageBackground />
  <div id="project-page_grid">
    <slot />
  </div>
</div>
<video
  class="border-solid border-2 border-active"
  id="project-page_video"
  autoplay
  loop
  muted
  playsinline
  src={`/${slug}/ANIMATION-header.mp4`}></video>
<Footer />
<script>
  import {
    calculateTileWidth,
    calculateNrOfRows,
    getNrOfColumns,
  } from "../assets/Functions";

  const projectPage = document.getElementById("project-page");
  const projectPageGrid = document.getElementById("project-page_grid");

  const drawGrid = () => {
    if (projectPageGrid && projectPage) {
      const localTileWidth = calculateTileWidth();
      projectPage.style.width = `${getNrOfColumns() * localTileWidth}px`;
      projectPageGrid.style.gridTemplateColumns = `repeat(${getNrOfColumns()}, ${localTileWidth}px)`;
      projectPageGrid.style.gridTemplateRows = `repeat(131, ${localTileWidth}px)`;
    }
  };

  const handleResize = () => {
    drawGrid();
  };

  window.addEventListener("resize", handleResize);

  drawGrid();
</script>
