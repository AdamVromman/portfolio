---
import { getLanguage, slugToLanguageKey } from "../assets/ServerFunctions";
import "../CSS/project-page.css";
import Footer from "./Footer.astro";
import ProjectPageBackground from "./ProjectPageBackground.astro";
import Languages from "../assets/Languages.json";

const { slug } = Astro.props;

const activeLanguage = getLanguage(Astro.currentLocale);
const copy = Languages[activeLanguage];
---

<div class="project-page">
  <video
    aria-label={copy.projects[slugToLanguageKey(slug)].alts.headerVideo}
    class="project-page-header-video"
    id={`project-page_video-${slug}`}
    autoplay
    loop
    muted
    playsinline
    src={`/assets/${slug}/ANIMATION-header.mp4`}></video>
  <div
    id={`project-page-${slug}`}
    data-slug={slug}
    class="project-page-container"
  >
    <ProjectPageBackground />
    <div id={`project-page_grid-${slug}`} class="project-page_grid">
      <slot />
    </div>
  </div>
  <video
    aria-label={copy.projects[slugToLanguageKey(slug)].alts.headerVideo}
    class="project-page-header-video border-solid border-2 border-active box-content"
    id={`project-page_video-${slug}`}
    autoplay
    loop
    muted
    playsinline
    src={`/assets/${slug}/ANIMATION-header.mp4`}></video>
  <Footer />
</div>
