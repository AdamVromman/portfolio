---
import "../CSS/background.css";
---

<div id="background">
  <svg id="background_svg"></svg>
  <script>
    import gsap from "gsap";
    import {
      calculateNrOfRows,
      calculateTileWidth,
      getNrOfColumns,
    } from "../assets/Functions";

    const background = document.getElementById("background");
    const backgroundSVG = document.getElementById("background_svg");
    const timeline = gsap.timeline({
      delay: 1.5,
      onComplete: () => {
        gsap.set("#home_intro", { display: "none" });
      },
    });

    const drawLines = (animated: boolean = false) => {
      if (background && backgroundSVG) {
        const nrOfRows = calculateNrOfRows(calculateTileWidth(background));
        backgroundSVG.textContent = "";
        const localTileWidth = calculateTileWidth(background);
        const svgNS = "http://www.w3.org/2000/svg";

        for (let i = 0; i < getNrOfColumns() / 2 + 1; i++) {
          const line = document.createElementNS(svgNS, "line");
          line.classList.add("background_svg_line");
          line.classList.add("line_vertical");
          line.classList.add("line_main");
          line.setAttribute("height", "0");
          line.setAttribute(
            "x",
            `${localTileWidth * 2 * i - (2 / (getNrOfColumns() + 1)) * i}px`
          );
          line.setAttribute("y", "0");
          backgroundSVG.appendChild(line);
          if (animated) {
            timeline.to(
              line,
              {
                duration: 1,
                attr: { height: "100%" },
                ease: "power4.out",
              },
              "<0.01"
            );
          } else {
            line.setAttribute("height", "100%");
          }
        }

        for (let i = 0; i < getNrOfColumns() / 2; i++) {
          const line = document.createElementNS(svgNS, "rect");
          line.classList.add("background_svg_line");
          line.classList.add("line_vertical");
          line.classList.add("line_sub");
          line.setAttribute("height", "0");
          line.setAttribute("width", "0.5px");
          line.setAttribute(
            "x",
            `${
              localTileWidth +
              localTileWidth * 2 * i -
              (1 / getNrOfColumns()) * i
            }px`
          );
          line.setAttribute("y", "0");
          backgroundSVG.appendChild(line);
          if (animated) {
            timeline.to(
              line,
              {
                duration: 1,
                attr: { height: "100%" },
                ease: "power4.out",
              },
              "<0.01"
            );
          } else line.setAttribute("height", "100%");
        }

        for (let i = 0; i < nrOfRows / 2 + 1; i++) {
          const line = document.createElementNS(svgNS, "rect");
          line.classList.add("background_svg_line");
          line.classList.add("line_horizontal");
          line.classList.add("line_main");
          line.setAttribute("width", "0");
          line.setAttribute("height", "2px");
          line.setAttribute(
            "y",
            `${localTileWidth * 2 * i - (2 / (nrOfRows + 1)) * i}px`
          );
          line.setAttribute("x", "0");
          backgroundSVG.appendChild(line);
          if (animated) {
            timeline.to(
              line,
              {
                duration: 1,
                attr: { width: "100%" },
                ease: "power4.out",
              },
              "<0.01"
            );
          } else line.setAttribute("width", "100%");
        }

        for (let i = 0; i < nrOfRows / 2; i++) {
          const line = document.createElementNS(svgNS, "rect");
          line.classList.add("background_svg_line");
          line.classList.add("line_horizontal");
          line.classList.add("line_sub");
          line.setAttribute("width", "0");
          line.setAttribute("height", "0.5px");
          line.setAttribute(
            "y",
            `${localTileWidth + localTileWidth * 2 * i - (1 / nrOfRows) * i}px`
          );
          line.setAttribute("x", "0");
          backgroundSVG.appendChild(line);
          if (animated) {
            timeline.to(
              line,
              {
                duration: 1,
                attr: { width: "100%" },
                ease: "power4.out",
              },
              "<0.01"
            );
          } else line.setAttribute("width", "100%");
        }
      }
    };

    document.addEventListener("assetsloaded", () => {
      drawLines(true);
    });

    const onResize = () => {
      drawLines();
    };

    window.addEventListener("resize", onResize);
  </script>
</div>
