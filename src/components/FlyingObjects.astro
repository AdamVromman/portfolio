---

---

<div id="flying-objects" class="absolute w-full h-full top-0 left-0 p-15 z-10">
  <div
    id="test"
    class="absolute z-0 top-0 left-0 bg-white border-2 border-project-trainworld"
  >
  </div>
  <div class="relative z-10 w-full h-full" id="canvas-container"></div>

  <script>
    import gsap from "gsap";
    import * as THREE from "three";
    import { DRACOLoader } from "three/addons/loaders/DRACOLoader.js";
    import { calculateNrOfRows, calculateTileWidth } from "../assets/Constants";

    let renderer: THREE.WebGLRenderer,
      scene: THREE.Scene,
      camera: THREE.PerspectiveCamera;

    const canvasContainer = document.getElementById("canvas-container");
    const test = document.getElementById("test");

    const projects = ["qausal"];
    const meshes: THREE.Mesh[] = [];
    const directions: { x: number; y: number }[] = [];

    const moveElement = (element: HTMLElement, x: number, y: number) => {
      if (canvasContainer) {
        const tileWidth = calculateTileWidth(canvasContainer);

        //const transformedX = Math.floor((x * 100 + 100) / 2);
        const transformedX = Math.floor(
          Math.floor(
            (((x * 100 + 100) / 2 / 100) * (canvasContainer.clientWidth - 30)) /
              (tileWidth / 2)
          ) *
            (tileWidth / 2)
        );
        const transformedY = Math.floor(
          Math.floor(
            (((y * -100 + 100) / 2 / 100) *
              (canvasContainer.clientHeight - 30)) /
              (tileWidth / 2)
          ) *
            (tileWidth / 2)
        );
        gsap.to(element, {
          duration: 0.3,
          left: 15 + transformedX,
          top: 15 + transformedY,
          ease: "linear",
          overwrite: true,
        });
      }
    };

    const createFlyingObject = (scene: THREE.Scene) => {
      const loader = new DRACOLoader();
      loader.setDecoderPath("/draco/");
      loader.preload();

      if (scene) {
        projects.forEach((project) => {
          loader.load(
            `/${project}.drc`,
            (geometry) => {
              geometry.center();
              const material = new THREE.MeshStandardMaterial({
                color: 0x2a35c9,
                roughness: 0.1,
                metalness: 0.7,
              });
              const mesh = new THREE.Mesh(geometry, material);
              mesh.position.set(
                -1 + Math.random() * 2,
                -1 + Math.random() * 2,
                0
              );
              meshes.push(mesh);
              scene.add(mesh);
              directions.push(chooseDirection());
            },
            (xhr) => {
              console.log((xhr.loaded / xhr.total) * 100 + "% loaded");
            },
            (error) => {
              console.log(error);
            }
          );
        });
      }
    };

    const render = () => {
      if (renderer && scene && camera) renderer.render(scene, camera);
    };

    const chooseDirection = () => {
      const x = 0.5 - Math.random();
      const y = 0.5 - Math.abs(x);
      return { x: x / 500, y: y / 500 };
    };

    const animate = () => {
      requestAnimationFrame(animate);

      const time = Date.now() * 0.001;

      meshes.forEach((mesh, index) => {
        if (mesh) {
          mesh.rotation.x = time;
          mesh.rotation.y = time;
          if (mesh.position.x > 1 || mesh.position.x < -1) {
            directions[index].x = -directions[index].x;
          }
          if (mesh.position.y > 1 || mesh.position.y < -1) {
            directions[index].y = -directions[index].y;
          }
          mesh.position.x += directions[index].x;
          mesh.position.y += directions[index].y;
          if (test) moveElement(test, mesh.position.x, mesh.position.y);
        }
      });

      render();
    };

    const init = () => {
      if (canvasContainer) {
        const localTileWidth = calculateTileWidth(canvasContainer);
        const NR_OF_ROWS = calculateNrOfRows(localTileWidth);
        const height = NR_OF_ROWS * localTileWidth;

        scene = new THREE.Scene();
        camera = new THREE.PerspectiveCamera(
          75,
          canvasContainer.clientWidth / height,
          0.1,
          1000
        );
        camera.position.z = 1.43;

        const light = new THREE.AmbientLight(0xffffff, 5); // soft white light
        scene.add(light);

        const pointLight = new THREE.PointLight(0xffffff, 1, 100);
        pointLight.position.set(0, 0, 1);
        scene.add(pointLight);

        const hemisphereLight = new THREE.HemisphereLight(
          0xffffbb,
          0x080820,
          1
        );
        scene.add(hemisphereLight);

        createFlyingObject(scene);

        renderer = new THREE.WebGLRenderer({
          antialias: true,
          alpha: true,
        });

        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;

        renderer.setSize(canvasContainer.clientWidth, height);
        canvasContainer.insertAdjacentElement(
          "afterbegin",
          renderer.domElement
        );
      }
    };

    const onWindowResize = () => {
      if (renderer && camera && canvasContainer) {
        const localTileWidth = calculateTileWidth(canvasContainer);
        const NR_OF_ROWS = calculateNrOfRows(localTileWidth);
        const height = NR_OF_ROWS * localTileWidth;
        if (test) {
          test.style.width = `${localTileWidth}px`;
          test.style.height = `${localTileWidth}px`;
        }

        camera.updateProjectionMatrix();

        renderer.setSize(canvasContainer.clientWidth, height);
      }
    };

    if (test && canvasContainer) {
      test.style.width = `${calculateTileWidth(canvasContainer)}px`;
      test.style.height = `${calculateTileWidth(canvasContainer)}px`;
    }
    init();
    requestAnimationFrame(animate);
    window.addEventListener("resize", onWindowResize);
  </script>
</div>
