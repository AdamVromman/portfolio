---
import "../CSS/flying-objects.css";
---

<div
  id="flying-objects"
  class="pointer-events-none absolute w-full h-full top-0 left-0 z-10"
>
  <div
    class="pointer-events-none relative z-10 w-full h-full"
    id="canvas-container"
  >
  </div>

  <script>
    import * as THREE from "three";
    import { DRACOLoader } from "three/addons/loaders/DRACOLoader.js";
    import RAPIER from "@dimforge/rapier3d-compat";
    import Stats from "three/addons/libs/stats.module.js";
    import { RGBELoader } from "three/examples/jsm/Addons.js";
    import gsap from "gsap";
    import { assetsLoaded, dynamicBodies, projects } from "../assets/Constants";
    import {
      handleMouseIn,
      handleMouseOut,
      hoveringBody,
      previousVel,
      setPreviousVel,
      calculateTileWidth,
      calculateNrOfRows,
      getNrOfColumns,
    } from "../assets/Functions";

    let stats: Stats;

    await RAPIER.init();
    const gravity = new RAPIER.Vector3(0.0, 0.0, 0.0);
    const world = new RAPIER.World(gravity);
    const frustumSize = 50;
    let previousVelDecreasing: RAPIER.Vector3 | undefined;

    let width: number, height: number;

    let renderer: THREE.WebGLRenderer,
      scene: THREE.Scene,
      camera: THREE.OrthographicCamera;

    let debug;

    let pointer: THREE.Vector2 = new THREE.Vector2();

    const canvasContainer = document.getElementById("canvas-container");

    const clock = new THREE.Clock();
    let delta;
    let clicked = false;

    let projectsLoaded = 0;

    const createBox = () => {
      if (scene) {
        const restitution = 1;
        const zTranslation = 2;
        const zRestitution = 0.1;
        const panelWidth = 100;
        const panelHeight = 0.1;
        const heightOffset = 0;
        const widthOffset = 0;

        const floorBody = world.createRigidBody(
          RAPIER.RigidBodyDesc.fixed()
            .setTranslation(0, camera.bottom + heightOffset, 0)
            .setRotation({ w: 0, x: 0, y: 1, z: 0 })
            .setLinearDamping(0)
            .setAngularDamping(0)
        );
        const floorShape = RAPIER.ColliderDesc.cuboid(
          panelWidth,
          panelHeight,
          panelWidth
        ).setRestitution(restitution);
        world.createCollider(floorShape, floorBody);

        const roofBody = world.createRigidBody(
          RAPIER.RigidBodyDesc.fixed()
            .setTranslation(0, camera.top - heightOffset, 0)
            .setLinearDamping(0)
            .setAngularDamping(0)
        );
        const roofShape = RAPIER.ColliderDesc.cuboid(
          panelWidth,
          panelHeight,
          panelWidth
        ).setRestitution(restitution);
        world.createCollider(roofShape, roofBody);

        const wallLeftBody = world.createRigidBody(
          RAPIER.RigidBodyDesc.fixed()
            .setTranslation(camera.left + widthOffset, 0, 0)
            .setLinearDamping(0)
            .setAngularDamping(0)
        );
        const wallLeftShape = RAPIER.ColliderDesc.cuboid(
          panelHeight,
          panelWidth,
          panelWidth
        ).setRestitution(restitution);
        world.createCollider(wallLeftShape, wallLeftBody);

        const wallRightBody = world.createRigidBody(
          RAPIER.RigidBodyDesc.fixed()
            .setTranslation(camera.right - widthOffset, 0, 0)
            .setLinearDamping(0)
            .setAngularDamping(0)
        );
        const wallRightShape = RAPIER.ColliderDesc.cuboid(
          panelHeight,
          panelWidth,
          panelWidth
        ).setRestitution(restitution);
        world.createCollider(wallRightShape, wallRightBody);

        const wallBackBody = world.createRigidBody(
          RAPIER.RigidBodyDesc.fixed()
            .setTranslation(0, 0, -zTranslation)
            .setLinearDamping(0)
            .setAngularDamping(0)
        );
        const wallBackShape = RAPIER.ColliderDesc.cuboid(
          panelWidth,
          panelWidth,
          panelHeight
        ).setRestitution(zRestitution);
        world.createCollider(wallBackShape, wallBackBody);

        const wallFrontBody = world.createRigidBody(
          RAPIER.RigidBodyDesc.fixed()
            .setTranslation(0, 0, zTranslation)
            .setLinearDamping(0)
            .setAngularDamping(0)
        );
        const wallFrontShape = RAPIER.ColliderDesc.cuboid(
          panelWidth,
          panelWidth,
          panelHeight
        ).setRestitution(zRestitution);
        world.createCollider(wallFrontShape, wallFrontBody);
      }
    };

    const createFlyingObject = () => {
      const loader = new DRACOLoader();
      loader.setDecoderPath("/draco/");
      loader.preload();

      const scale = (width + height) / 50;

      if (scene) {
        // Train World

        projects.forEach((project) => {
          loader.load(
            `/${project.slug}.drc`,
            (geometry) => {
              geometry.center();
              geometry.scale(scale, scale, scale);
              const material = new THREE.MeshStandardMaterial({
                color: new THREE.Color(`#${project.color}`),
                roughness: 0,
                metalness: 1,
              });
              const mesh = new THREE.Mesh(geometry, material);
              scene.add(mesh);
              const projectBody = world.createRigidBody(
                RAPIER.RigidBodyDesc.dynamic()
                  .setTranslation(
                    camera.right - Math.random() * camera.right * 2,
                    camera.top - Math.random() * camera.top * 2,
                    -20
                  )
                  .setRotation({ w: 0.5, x: 0.5, y: 0, z: 0 })
                  .setCanSleep(false)
                  .setLinearDamping(0)
                  .setAngularDamping(0)
              );

              projectBody.setEnabledTranslations(true, true, false, false);

              let projectShape;
              const element = document.createElement("a");
              element.className = `flying-object-link ${project.slug}`;
              element.href = `/${project.slug}`;
              canvasContainer?.appendChild(element);

              if (project.slug === "train-world") {
                projectShape = RAPIER.ColliderDesc.cylinder(
                  0.015 * scale,
                  0.095 * scale
                );

                element.style.width = "120px";
                element.style.height = "120px";
                element.style.transform = "translate(-50%, -50%)";
              } else if (project.slug === "club-sofa") {
                projectShape = RAPIER.ColliderDesc.cylinder(
                  0.015 * scale,
                  0.095 * scale
                );
                element.style.width = "30px";
                element.style.height = "30px";
                element.style.width = "120px";
                element.style.height = "120px";
                element.style.transform = "translate(-50%, -50%)";
              } else {
                projectShape = RAPIER.ColliderDesc.cylinder(
                  0.015 * scale,
                  0.095 * scale
                );
                element.style.width = "30px";
                element.style.height = "30px";
              }

              projectShape.setMass(100).setRestitution(1);
              world.createCollider(projectShape, projectBody);

              projectBody.applyImpulseAtPoint(
                new RAPIER.Vector3(
                  Math.random() * 100,
                  Math.random() * 100,
                  Math.random() * 100
                ),
                new RAPIER.Vector3(Math.random(), Math.random(), Math.random()),
                true
              );

              projectBody.applyImpulse(
                new RAPIER.Vector3(
                  Math.random() * 1000 - 500,
                  Math.random() * 1000 - 500,
                  0
                ),
                true
              );

              const flyingBody = {
                mesh: mesh,
                body: projectBody,
                element: element,
                slug: project.slug,
              };
              element.addEventListener("mouseenter", () => {
                console.log("mouseenter", clicked);
                if (!clicked) {
                  handleMouseIn(project.slug);
                } else {
                  clicked = false;
                }
              });

              element.addEventListener("mouseleave", () => {
                console.log("mouseleave", clicked);
                if (!clicked) {
                  console.log("mouseleave");
                  handleMouseOut(project.slug);
                }
              });

              element.addEventListener("click", () => {
                console.log("clicked", clicked);
                clicked = true;
              });

              dynamicBodies.push(flyingBody);
            },
            (xhr) => {
              if (projectsLoaded < projects.length - 1) {
                projectsLoaded++;
              } else {
                console.log((xhr.loaded / xhr.total) * 100 + "% loaded");
                document.dispatchEvent(assetsLoaded);
              }
            },
            (error) => {
              console.log(error);
            }
          );
        });
      }
    };

    const render = () => {
      if (renderer && scene && camera) renderer.render(scene, camera);
    };

    const decreaseValue = (value: number) => {
      if (value > 0) {
        return Math.max(value - 0.05, 0);
      } else {
        return Math.min(value + 0.05, 0);
      }
    };

    const animate = () => {
      requestAnimationFrame(animate);
      stats.update();

      // const { vertices, colors } = world.debugRender();
      // debug.geometry.setAttribute(
      //   "position",
      //   new THREE.BufferAttribute(vertices, 3)
      // );
      // debug.geometry.setAttribute(
      //   "color",
      //   new THREE.BufferAttribute(colors, 4)
      // );

      delta = clock.getDelta();
      world.timestep = Math.min(delta, 0.1);
      world.step();

      for (let i = 0, n = dynamicBodies.length; i < n; i++) {
        if (dynamicBodies[i] === hoveringBody) {
          if (previousVel === undefined)
            setPreviousVel(dynamicBodies[i].body.linvel());
          previousVelDecreasing = dynamicBodies[i].body.linvel();
          const vel = previousVelDecreasing
            ? new RAPIER.Vector3(
                decreaseValue(previousVelDecreasing.x),
                decreaseValue(previousVelDecreasing.y),
                0
              )
            : dynamicBodies[i].body.linvel();
          dynamicBodies[i].body.setLinvel(vel, true);
        }

        dynamicBodies[i].mesh.position.copy(
          dynamicBodies[i].body.translation()
        );
        dynamicBodies[i].mesh.quaternion.copy(dynamicBodies[i].body.rotation());
        gsap.set(dynamicBodies[i].element, {
          x:
            ((dynamicBodies[i].mesh.position.x + camera.right) /
              (camera.right * 2)) *
            width,
          y:
            ((dynamicBodies[i].mesh.position.y + camera.bottom) /
              (camera.bottom * 2)) *
            height,
        });
      }

      render();
    };

    const init = () => {
      if (canvasContainer) {
        const localTileWidth = calculateTileWidth();
        const NR_OF_ROWS = calculateNrOfRows(localTileWidth);

        canvasContainer.style.height = `${NR_OF_ROWS * localTileWidth}px`;
        canvasContainer.style.width = `${getNrOfColumns() * localTileWidth}px`;

        height = canvasContainer.clientHeight;
        width = canvasContainer.clientWidth;
        const aspect = canvasContainer.clientWidth / height;

        scene = new THREE.Scene();
        camera = new THREE.OrthographicCamera(
          (frustumSize * aspect) / -2,
          (frustumSize * aspect) / 2,
          frustumSize / 2,
          frustumSize / -2,
          0.1,
          200
        );

        new RGBELoader()
          .setPath("/")
          .load("background.hdr", function (texture) {
            texture.mapping = THREE.EquirectangularReflectionMapping;
            scene.environment = texture;
          });

        camera.position.set(0, 0, 10);
        camera.lookAt(0, 0, 0);
        camera.updateProjectionMatrix();

        const light = new THREE.DirectionalLight(0xffffff, 3);
        light.position.set(1, 1, 1).normalize();
        //scene.add(light);

        createFlyingObject();
        createBox();

        debug = new THREE.LineSegments(
          new THREE.BufferGeometry(),
          new THREE.LineBasicMaterial({ color: 0xffffff, vertexColors: true })
        );
        debug.frustumCulled = false;
        scene.add(debug);

        renderer = new THREE.WebGLRenderer({
          antialias: true,
          alpha: true,
        });

        renderer.setPixelRatio(window.devicePixelRatio);
        renderer.setSize(width, height);
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.domElement.style.pointerEvents = "none";
        canvasContainer.insertAdjacentElement(
          "afterbegin",
          renderer.domElement
        );

        stats = new Stats();
        document.body.appendChild(stats.dom);
      }
    };

    const onPointerMove = (event: PointerEvent) => {
      pointer.x = ((event.clientX - 15) / width) * 2 - 1;
      pointer.y = -((event.clientY - 15) / height) * 2 + 1;
    };

    const onWindowResize = () => {
      if (renderer && camera && canvasContainer) {
        height = canvasContainer.clientHeight;
        width = canvasContainer.clientWidth;

        const aspect = width / height;

        camera.left = (frustumSize * aspect) / -2;
        camera.right = (frustumSize * aspect) / 2;
        camera.top = frustumSize / 2;
        camera.bottom = frustumSize / 2;

        camera.updateProjectionMatrix();

        renderer.setSize(width, height);
      }
    };

    init();
    requestAnimationFrame(animate);

    window.addEventListener("pointermove", onPointerMove);
    window.addEventListener("resize", onWindowResize);
  </script>
</div>
