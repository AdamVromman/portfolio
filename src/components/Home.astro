    </div>
    <div class="grid_cell left home_grid_discover-work">
      <div class="grid_cell_container">
        <span class="half-col-text">Discover my work:</span>
      </div>
    </div>
    <div class="grid_cell right home_grid_works">
      <div class="grid_cell_container">
        <div class="home_grid_works_container container-1">
          {
            projects.map((project, index) => {
              return (
                <>
                  {index !== 0 && <span class="half-col-text">—</span>}
                  <a
                    class="half-col-text"
                    href={`/${project.slug}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {project.name}
                  </a>
                </>
              );
            })
          }
        </div>
        <div class="home_grid_works_container container-2">
          {
            projects.map((project, index) => {
              return (
                <>
                  {index !== 0 && <span class="half-col-text">—</span>}
                  <a
                    class="half-col-text"
                    href={`/${project.slug}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {project.name}
                  </a>
                </>
              );
            })
          }
        </div>
      </div>
    </div>
    <div class="grid_cell top home_grid_text">
      <div class="grid_cell_container">
        <p>
          I’m Adam Vromman, a Belgian designer and dev. I mix bold design with
          clean code—serious about the details, but never too stiff. Two
          degrees, endless grids, and a love for creative coding.
        </p>
      </div>
    </div>
  </div>
  <FlyingObjects />
  {/* <Footer /> */}
  <script>
    import {
      calculateTileWidth,
      calculateNrOfRows,
      getNrOfColumns,
    } from "../assets/Functions";

    const home = document.getElementById("home");
    const homeGrid = document.getElementById("home_grid");
    const drawGrid = () => {
      if (home && homeGrid) {
        const localTileWidth = calculateTileWidth(homeGrid);
        const NR_OF_ROWS = calculateNrOfRows(localTileWidth);
        homeGrid.style.height = `${NR_OF_ROWS * localTileWidth}px`;
        homeGrid.style.gridTemplateColumns = `repeat(${getNrOfColumns()}, 1fr)`;
        homeGrid.style.gridTemplateRows = `repeat(${NR_OF_ROWS}, 1fr)`;
      }
    };

    const handleResize = () => {
      drawGrid();
    };

    drawGrid();
    window.addEventListener("resize", handleResize);
  </script>
</div>
