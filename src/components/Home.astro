    <video
      class="home_video train-world"
      src="/FINAL VIDEO_1.webm"
      autoplay
      muted
      loop
      preload="auto"></video>
    <video
      class="home_video club-sofa"
      src="/FINAL VIDEO_1.webm"
      autoplay
      muted
      loop
      preload="auto"></video>

