---
import "../CSS/main.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>ADAM VROMMAN</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <script>
      import gsap from "gsap";

      const homeStartupTimeline = gsap
        .timeline()
        .from(
          ".grid_cell.bottom .grid_cell_container",
          {
            duration: 1,
            y: "100%",
            ease: "power4.out",
          },
          0
        )
        .from(
          ".grid_cell.top .grid_cell_container",
          {
            duration: 1,
            y: "-100%",
            ease: "power4.out",
          },
          0
        )
        .from(
          ".grid_cell.left .grid_cell_container",
          {
            duration: 1,
            x: "-100%",
            ease: "power4.out",
          },
          0
        )
        .from(
          ".grid_cell.right .grid_cell_container",
          {
            duration: 1,
            x: "100%",
            ease: "power4.out",
          },
          0
        );

      window.addEventListener("load", () => {
        console.log("Page loaded");
        console.log(homeStartupTimeline);
        homeStartupTimeline.play();
      });
    </script>
  </body>
</html>
