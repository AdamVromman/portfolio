---
import Home from "../components/Home.astro";
import "../CSS/main.css";
import { ClientRouter } from "astro:transitions";

const { slug } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>ADAM VROMMAN</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <div id="grid-calculator"></div>
    <div id="grid-container" class={slug ? "project-page " + slug : ""}>
      <Home />
      <slot />
    </div>

    <script>
      import gsap from "gsap";
      import { selectedProject } from "../assets/Functions";

      const homeStartupTimeline = gsap
        .timeline({ delay: 2, paused: true })
        .from(
          ".grid_cell.bottom .grid_cell_container",
          {
            duration: 1,
            y: "100%",
            ease: "power4.out",
          },
          0
        )
        .from(
          ".grid_cell.top .grid_cell_container",
          {
            duration: 1,
            y: "-100%",
            ease: "power4.out",
          },
          0
        )
        .from(
          ".grid_cell.left .grid_cell_container",
          {
            duration: 1,
            x: "-100%",
            ease: "power4.out",
          },
          0
        )
        .from(
          ".grid_cell.right .grid_cell_container",
          {
            duration: 1,
            x: "100%",
            ease: "power4.out",
          },
          0
        );
      // .from(
      //   "#flying-objects",
      //   {
      //     scale: 0,
      //     opacity: 0,
      //     duration: 1,
      //     ease: "power4.out",
      //   },
      //   0
      // );

      document.addEventListener("assetsloaded", () => {
        document.body.style.opacity = "1";
        if (!selectedProject) homeStartupTimeline.play();
      });
    </script>
  </body>
</html>
