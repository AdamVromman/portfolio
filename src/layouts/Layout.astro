---
import Home from "../components/Home.astro";
import "../CSS/main.css";
import { ClientRouter, slide } from "astro:transitions";

const { slug } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>ADAM VROMMAN</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body data-slug={slug} transition:persist>
    <div id="grid-calculator"></div>
    <div id="grid-container" class={`${slug ? slug : ""}`}>
      <Home slug={slug} />
      <slot />
    </div>
    <script>
      import gsap from "gsap";
      import { projects } from "../assets/Constants";
      import {
        drawProjectPageGrid,
        loadHomePage,
        loadProjectPage,
        navigateProjectPageToHomePage,
        navigateHomePageToProjectPage,
        setSelectedProject,
        sizeGrid,
        loadAboutMePage,
        navigateHomePageToAboutMePage,
        navigateAboutMeToHomePage,
        drawHomeGrid,
      } from "../assets/Functions";

      const analyseURL = () => {
        const slug = document.body.dataset.slug;
        console.log("slug:", slug);
        return slug;
      };

      const handleResize = () => {
        sizeGrid();
        const url = analyseURL();
        console.log("Resizing grid for URL:", url);

        if (url === "about-me" || url === "home") {
          drawHomeGrid(true);
        } else {
          drawProjectPageGrid();
        }
      };

      const fixTabIndeces = (slug: string) => {
        const allElements = document.querySelectorAll(
          ".tabindex"
        ) as NodeListOf<HTMLElement>;

        allElements.forEach((el) => {
          el.tabIndex = -1;
        });

        const key = slug === "home" || slug === "about-me" ? slug : "projects";
        const tabindexElements = document.querySelectorAll(
          `.tabindex_${key}`
        ) as NodeListOf<HTMLElement>;
        tabindexElements.forEach((el) => {
          el.tabIndex = 0;
        });
      };

      sizeGrid();

      let pathName = "";

      window.addEventListener("resize", handleResize);

      document.addEventListener("astro:before-swap", (e) => {
        pathName = e.from.pathname.replaceAll("/", "");
      });

      document.addEventListener("astro:after-swap", () => {
        console.log("astro:after-swap event triggered");
        console.log(pathName);

        gsap.set("body", {
          opacity: 1,
          ease: "power2.inOut",
        });

        const url = analyseURL();
        fixTabIndeces(url || "home");

        const project = projects.find((p) => p.slug === url);
        if (url === "about-me") {
          console.log("About page navigated");
          navigateHomePageToAboutMePage();
        } else if (project) {
          console.log(`Project page navigated for: ${url}`);
          setSelectedProject(project);
          navigateHomePageToProjectPage();
        } else {
          console.log("Home page navigated");
          setSelectedProject(undefined);
          if (pathName === "about-me") {
            navigateAboutMeToHomePage();
          } else {
            navigateProjectPageToHomePage();
          }
        }
      });

      window.addEventListener("load", () => {
        console.log("load event triggered");

        gsap.to("body", {
          duration: 0.5,
          opacity: 1,
          ease: "power2.inOut",
        });

        const url = analyseURL();
        console.log("Current URL slug:", url);
        fixTabIndeces(url || "home");

        const project = projects.find((p) => p.slug === url);
        if (url === "about-me") {
          console.log("About page loaded");
          loadAboutMePage();
        } else if (project) {
          console.log(`Project page loaded for: ${url}`);
          setSelectedProject(project);
          loadProjectPage();
        } else {
          console.log("Home page loaded");
          loadHomePage();
          setSelectedProject(undefined);
        }
      });
    </script>
  </body>
</html>
