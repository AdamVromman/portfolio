---
import Home from "../components/Home.astro";
import "../CSS/main.css";
import { ClientRouter, slide } from "astro:transitions";

const { slug } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>ADAM VROMMAN</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body transition:persist>
    <div id="grid-calculator"></div>
    <div id="grid-container" class={`${slug ? slug : ""}`}>
      <Home />
      <slot />
    </div>
    <script>
      import gsap from "gsap";
      import { projects } from "../assets/Constants";
      import {
        calculateTileWidth,
        drawProjectPageGrid,
        getNrOfColumns,
        loadHomePage,
        loadProjectPage,
        navigateToHomePage,
        navigateToProjectPage,
        setSelectedProject,
      } from "../assets/Functions";

      const sizeGrid = () => {
        const localTileWidth = calculateTileWidth("Layout.sizeGrid");
        const gridContainer = document.getElementById("grid-container");
        if (gridContainer) {
          gridContainer.style.width = `${getNrOfColumns() * localTileWidth}px`;
        }
      };

      const analyseURL = (url: string) => {
        const urlParts = url.split("/");
        const lastPart = urlParts[urlParts.length - 1];
        return lastPart;
      };

      const handleResize = () => {
        sizeGrid();
        drawProjectPageGrid();
      };

      sizeGrid();

      window.addEventListener("resize", handleResize);

      document.addEventListener("astro:after-swap", () => {
        console.log("astro:after-swap event triggered");

        gsap.set("body", {
          opacity: 1,
          ease: "power2.inOut",
        });

        const url = analyseURL(window.location.href);
        const project = projects.find((p) => p.slug === url);
        if (url === "about") {
          console.log("About page navigated");
        } else if (project) {
          console.log(`Project page navigated for: ${url}`);
          setSelectedProject(project);
          navigateToProjectPage();
        } else {
          console.log("Home page navigated");
          setSelectedProject(undefined);
          navigateToHomePage();
        }
      });

      window.addEventListener("load", () => {
        console.log("load event triggered");

        gsap.to("body", {
          duration: 0.5,
          opacity: 1,
          ease: "power2.inOut",
        });

        const url = analyseURL(window.location.href);
        const project = projects.find((p) => p.slug === url);
        if (url === "about") {
          console.log("About page loaded");
        } else if (project) {
          console.log(`Project page loaded for: ${url}`);
          setSelectedProject(project);
          loadProjectPage();
        } else {
          console.log("Home page loaded");
          loadHomePage();
          setSelectedProject(undefined);
        }
      });
    </script>
  </body>
</html>
