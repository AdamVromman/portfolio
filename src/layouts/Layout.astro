---
import Home from "../components/Home.astro";
import "../CSS/main.css";
import { ClientRouter, slide } from "astro:transitions";

const { slug } = Astro.props;

const anim = {
  old: {
    name: "pageTransitionOut",
    duration: "1s",
    easing: "ease-in",
  },
  new: {
    name: "pageTransitionIn",
    duration: "1s",
    delay: "0.3s",
    easing: "ease-in-out",
  },
};

const anim2 = {
  old: {
    name: "pageTransitionIn",
    duration: "1s",
    easing: "ease-in-out",
    direction: "reverse",
  },
  new: {
    name: "pageTransitionOut",
    duration: "1s",
    easing: "ease-in-out",
    direction: "reverse",
  },
};

const customTransition = {
  forwards: anim,
  backwards: anim2,
};
---

<!doctype html>
<html lang="en" transition:animate={customTransition}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>ADAM VROMMAN</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <div id="grid-calculator"></div>
    <div id="grid-container" class={slug ? "project-page " + slug : ""}>
      <Home />
      <slot />
    </div>
    <script>
      import { calculateTileWidth, getNrOfColumns } from "../assets/Functions";

      const sizeGrid = () => {
        const gridContainer = document.getElementById("grid-container");
        if (gridContainer) {
          const localTileWidth = calculateTileWidth();
          gridContainer.style.width = `${getNrOfColumns() * localTileWidth}px`;
        }
      };

      sizeGrid();
      window.addEventListener("resize", sizeGrid);
    </script>
    <script>
      import gsap from "gsap";
      import { projects } from "../assets/Constants";
      import {
        justifyParagraphs,
        loadHomePage,
        loadProjectPage,
        navigateToHomePage,
        navigateToProjectPage,
        selectedProject,
        setSelectedProject,
      } from "../assets/Functions";

      window.addEventListener("resize", justifyParagraphs);

      let firstLoad = true;

      document.addEventListener("assetsloaded", () => {
        console.log("Assets loaded");
        firstLoad = false;
        const gridContainer = document.getElementById("grid-container");
        if (gridContainer && gridContainer.classList.contains("project-page")) {
          const slug = gridContainer.classList[1];
          const project = projects.find((p) => p.slug === slug);
          if (project) {
            setSelectedProject(project);
            loadProjectPage();
          }
        } else {
          setSelectedProject(undefined);
          loadHomePage();
        }
        justifyParagraphs();
      });
      document.addEventListener("astro:page-load", () => {
        gsap.to("body", {
          duration: 0.2,
          opacity: 1,
          ease: "power3.out",
        });
        if (!firstLoad) {
          const gridContainer = document.getElementById("grid-container");
          if (
            gridContainer &&
            gridContainer.classList.contains("project-page")
          ) {
            const slug = gridContainer.classList[1];
            const project = projects.find((p) => p.slug === slug);
            if (project) {
              setSelectedProject(project);
              navigateToProjectPage();
            }
          } else {
            setSelectedProject(undefined);
            navigateToHomePage();
          }
          justifyParagraphs();
        }
      });
    </script>
  </body>
</html>
<style is:global>
  @keyframes pageTransitionOut {
    0% {
      transform: scale(1);
      opacity: 1;
      filter: blur(0px);
    }
    100% {
      opacity: 0;
      filter: blur(10px);
      transform: scale(0.9);
    }
  }

  @keyframes pageTransitionIn {
    0% {
      opacity: 0;
      filter: blur(10px);
      transform: scale(2);
    }
    100% {
      transform: scale(1);
      opacity: 1;
      filter: blur(0px);
    }
  }

  @keyframes homeOut {
    0% {
      transform: scale(1);
      opacity: 1;
      filter: blur(0px);
    }
    100% {
      transform: scale(0.9);
      opacity: 0;
      filter: blur(10px);
    }
  }
</style>
